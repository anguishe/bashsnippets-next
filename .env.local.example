# ------------------------------------------------------------------------------
# bashsnippets-next — environment reference
# ------------------------------------------------------------------------------
# Copy to .env.local (gitignored) and fill in:   cp .env.local.example .env.local
#
# NEXT_PUBLIC_* values are inlined at BUILD time. Setting one in Vercel changes
# nothing until the next build runs — push a commit or redeploy.
#
# Set the same NEXT_PUBLIC_* values in Vercel → Project → Settings → Environment
# Variables (all three environments). INDEXNOW_KEY and DEVTO_API_KEY are used only
# by local scripts and do not belong in Vercel.
# ------------------------------------------------------------------------------

# Canonical site origin, no trailing slash. Read per page/route as
# `process.env.NEXT_PUBLIC_SITE_URL ?? 'https://bashsnippets.xyz'` (~20 files,
# plus src/lib/author.ts and rss.xml/route.ts).
NEXT_PUBLIC_SITE_URL=https://bashsnippets.xyz

# Google Analytics 4 measurement ID. Read by src/app/layout.tsx (fallback G-6B01TGE8XS).
# Consent Mode v2 keeps ad_storage / ad_user_data / ad_personalization DENIED on every
# path — the site runs no ads. Do not add an AdSense variable back.
NEXT_PUBLIC_GA_ID=G-6B01TGE8XS

# Buttondown newsletter slug — the BARE username, not a URL. EmailCapture.tsx builds
# https://buttondown.com/api/emails/embed-subscribe/<username> from it and renders
# nothing when unset. A full profile URL here produces a 404 form action.
NEXT_PUBLIC_BUTTONDOWN_USERNAME=anguishe

# IndexNow key. Public by design — the verification file is public/<key>.txt.
# Read by scripts/submit-indexnow.mjs (`npm run indexnow`). One key covers Bing,
# Yandex, Seznam and Naver.
INDEXNOW_KEY=a7fae2a4e86d4822ab3f636599173c8f

# dev.to API key — SECRET, local only, never commit, never put in Vercel. Has write
# access to the bashsnippets dev.to account; used by the canonical-repair scripts.
DEVTO_API_KEY=
